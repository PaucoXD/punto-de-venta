{
  "name": "punto-de-venta",
  "productName": "Punto de Venta",
  "version": "1.0.0",
  "description": "Punto de venta para tienditas, distribuidoras y refaccionarias",
  "author": "PaucoXD",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "escritorio": "electron .",
    "instalador": "electron-builder --win --publish never",
    "publicar": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "mx.paucoxd.puntodeventa",
    "productName": "Punto de Venta",
    "artifactName": "Punto-de-Venta-${version}-instalador.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "iconos/**",
      "fuentes/**",
      "vendor/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "iconos/icono.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Punto de Venta",
      "language": "3082"
    },
    "publish": {
      "provider": "github",
      "owner": "PaucoXD",
      "repo": "punto-de-venta",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
